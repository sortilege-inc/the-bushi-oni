    # The current sheet: foundry/fvtt-Actor-tsume-kunimichi-48-xp-(master-saboteur,-rank-3)-2cTMh1JxGL7nQ3jP.2025-10-27.json.
    #BOgmTsumeKunimichi ^"Tsume Kunimichi" DEF {
        EXTENDS #L5R003xY4zA6bC8dE0fG2hI ^"Samurai"
        PROPERTIES {
            ^"Name" STRING "Tsume Kunimichi" FIXED
            ^"Foundry Name" STRING "Tsume Kunimichi 48 XP (Master Saboteur, Rank 3)"
            ^"Clan" STRING "Crane" FIXED
            ^"Family" STRING "Tsume" FIXED
            ^"School" STRING "Daidoji Harrier"
            ^"School Rank" INTEGER 3
            ^"Roles" LIST OF STRING ["Shinobi"]
            ^"Rings" DEF { ^"Air" INTEGER 3 ^"Earth" INTEGER 1 ^"Fire" INTEGER 2 ^"Water" INTEGER 2 ^"Void" INTEGER 3 }
            ^"Honor" INTEGER 40
            ^"Glory" INTEGER 44
            ^"Status" INTEGER 45
            ^"Endurance" INTEGER 6
            ^"Composure" INTEGER 6
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Void Points" INTEGER 3
            ^"Ninjō" STRING "To see the rigid hierarchy that keeps the common people suffering finally brought low. Kunimichi has witnessed too much injustice perpetuated by the celestial order - peasants starving while nobles feast, talented individuals held back by birth, and the Emperor's divine mandate used to justify cruelty. He longs for a world where merit and compassion matter more than bloodline and divine favor. This desire constantly puts him at odds with his official duties, as he must publicly support the very system he secretly works to undermine."
            ^"Giri" STRING "Daidoji Masahiro, a regional administrator who oversees border territories and trade routes. Kunimichi's official duty is to serve as an advance scout and intelligence gatherer, traveling ahead of diplomatic missions to assess threats and gather information about local conditions. His reputation for thoroughness and discretion makes him invaluable for sensitive assignments where the Crane need eyes and ears in unfriendly territory."
