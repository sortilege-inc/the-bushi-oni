      "step4": {
        "stand_out": "I exhibit a natural affinity for fire kami. Teachers whispers that my talents feels less learned and more fated, as if my kami noticed me before others did. My spells are larger, louder, and burn brighter. Some of the teachers are concerned about my growth.",
        "ring": "earth"
      },
      "step5": {
        "social_giri": "I serve under Isawa Uona, an Elemental Master of fire. He provides me with guidance but feels like I am able to guide my own path within the school. Uona provides me with direction."
      },
      "step6": {
        "social_ninjo": "I want to know why the elements move and interact as they do. Why harmony is so easily broken. "
      },
      "step7": {
        "clan_relations": "I feel as though there is too much burden on the Pheonix clan, as each generation seems to be carrying more weight then previous ones.",
        "skill": "sentiment",
        "social_add_glory": 0
      },
      "step8": {
        "bushido": "I have great respect for the bushido as they are a mortal attempt to define truths.",
        "skill": "none",
        "social_add_honor": 10,
        "tenet_paramount": "Gi",
        "tenet_less_significant": "Rei",
        "item": []
      },
      "step9": {
        "success": "Other people have heard of me for my ability to get results at any costs, and they believe it by default unless given evidence to the contrary",
        "distinction": [
          "L5RCoreDis000014"
        ]
      },
      "step10": {
        "difficulty": "I am well known but not for the right reasons. Characters who do not know me personally always assume that those around me will perish or meet bad ends. This comes from my natural affinity to call upon the elements with less training than most, which gives pause to those who don't know me.",
        "adversity": [
          "L5RCoreAdv000046"
        ]
      },
      "step11": {
        "calms": "I risk my life without consideration or hesitation, even if the potential consequences are obvious and dire",
        "passion": [
          "L5RCorePas000005"
        ]
      },
      "step12": {
        "worries": "I believe I'm destined for greatness and nothing will dissuade me from my fixation upon that goal.",
        "anxiety": [
          "L5RCoreAnx000005"
        ]
      },
      "step13": {
        "most_learn": "theatrical Kakita duelist who taught you that style is power. From them you learned your stance, your flair, your dramatic timing.",
        "skill": "performance",
        "advantage": [],
        "disadvantage": [
          "L5RCoreAnx000034"
        ]
      },
      "step14": {
        "first_sight": "My gold glasses, they are striking and seem to give a sharp reflection anytime I need to speak to someone with intent. Additionally, I carry a gorgeously folded fan painted with rising flames. When opened, a thin shimmer of heat ripples the air. I absolutely use it for emphasis during conversations.",
        "special_features": [
          "L5RCoreIte000039"
        ]
      },
      "step15": {
        "stress": "I laugh in the face of danger, it helps hide my real emotions."
      },
      "step16": {
        "relations": "Asako Junpei who is a flamboyant storyteller and helped encourage my larger-than-life persona. He gave me sand clock that I like to pull out when I am tired of conversation and want to make things happen expeditously ",
        "item": [
          "L5RCoreIte000119"
        ]
      },
      "step17": {
        "parents_pov": "They are proud beyond measure, but terrified that my brilliance will draw envy and disaster",
        "skill": "command",
        "bond": []
      },
      "step18": {
        "heritage_name": "Isawa Arasou, a famous Pheonix shugenja known for daring feats that defied tradition.",
        "heritage_1": 5,
        "heritage_2": 3,
        "heritage_item": [],
        "heritage_add_honor": 0,
        "heritage_add_glory": 3,
        "heritage_add_status": 0,
        "skill": "sentiment"
      },
      "step19": {
        "firstname": "Isawa Endo"
      },
      "step20": {
        "death": "Holding the line, in a blaze of fire set forth by himself using every last bit of magic he has"
      },
